NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Set to false only for local dev without TOTP setup
NEXT_PUBLIC_REQUIRE_PORTAL_MFA=true
# Portal session: sign out after 30 min idle and 8 h max (also caps auth cookie lifetime)
NEXT_PUBLIC_SESSION_IDLE_MS=1800000
NEXT_PUBLIC_SESSION_ABSOLUTE_MS=28800000